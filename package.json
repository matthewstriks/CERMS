{
  "name": "cerms-5",
  "productName": "CERMS 5",
  "version": "5.0.0-alpha.1",
  "private": true,
  "description": "Club Entertainment Record Management System",
  "author": "RocMTSSolutions LLC.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "npm run typecheck && electron-vite build",
    "check": "npm run test && npm run build",
    "test:smoke": "npm run build && node scripts/smoke.mjs",
    "test:membership": "npm run build && node scripts/membership-smoke.mjs",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --publish never",
    "test:admissions": "node scripts/admissions-emulator.mjs",
    "dev:members": "node scripts/member-creation-emulator.mjs",
    "test:member-creation": "node scripts/member-creation-emulator.mjs --test",
    "test:about": "npm run build && node scripts/about-smoke.mjs",
    "test:rules": "node scripts/test-firestore-rules.mjs"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.63.0",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "com.rocmtssolutions.cerms5",
    "productName": "CERMS 5",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "resources/branding/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/branding/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "resources/branding/linux"
    },
    "extraResources": [
      {
        "from": "resources/branding/icon.png",
        "to": "branding/icon.png"
      }
    ]
  }
}
